#the delete function deletes an entry from the dictionary
def delete(students):
    name = input("Enter a name: ")      #get a name to lookup

    #if the name is found, delete the entry and remove the name from the list of names
    if name in students:
        del students[name]
        NAME_LIST.remove(name)
    else:
        print("That student was not found.")
