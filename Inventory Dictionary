#this program uses a dictionary to track students names, student ID numbers,
#their House, school subjects, and magical items/supplies they need for course material

#global constants
LOOK_UP = 1     #these are all menu options
ADD = 2
DELETE = 3
SHOW = 4
QUIT = 5
MAX_COURSES = 7 #the maximum amount of courses a student can take
NAME_LIST = []  #intializing the list for student names

#create main
def main():
    students = {}      #create an empty dictionary

    choice = 0          #intialize choice for user


    #as long as the user doesn't hit quit the program will repeat
    while choice != QUIT:
        choice = get_menu_choice()  #get the user's menu choice

        #process choice by calling the functions
        if choice == LOOK_UP:
            look_up(students)
        elif choice == ADD:
            add(students)
        elif choice == DELETE:
            delete(students)
        elif choice == SHOW:
            show(students)
#set up the menu and introduce the program
def get_menu_choice():
    print()
    print("This program allows you to manage students at the Tianyuan Academy of Magic.")
    print("You can look a student up as well their ID number, House, subjects, and needed"+
          " magical materials pertaining to them.")
    print("Students can only have 7 classes maximum, they cannot be enrolled in more.")
    print("---------------------------")
    print("1 Look up student.")
    print("2 Add a new student.")
    print("3 Delete a student.")
    print("4 Show list of all registered students.")
    print("5 Quit program.")
    print()

    choice = int(input("Enter your choice:"))       #get the user's choice

    while choice < LOOK_UP or choice > QUIT:        #validate user's choice
        choice = int(input("Invalid response, enter a valid choice: "))

    return choice

#the look up function looks up a name in the students dictionary
def look_up(students):
    name = input("Enter a name: ")      #get a name to look up

    print(students.get(name, "Student was not found."))

